<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VasiliasTyper" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vt_primary</item>
        <item name="colorPrimaryVariant">@color/vt_primary_dark</item>
        <item name="colorSecondary">@color/vt_secondary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/ink_surface</item>
        <item name="colorOnSurface">@color/ps_text</item>
        <item name="colorOnBackground">@color/ps_text_bright</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:colorAccent">@color/ps_accent</item>
        <item name="android:windowBackground">@color/ink_navy</item>
        <item name="android:statusBarColor">@color/ink_navy</item>
        <item name="android:navigationBarColor">@color/ink_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="materialAlertDialogTheme">@style/InkAlertDialog</item>
    </style>

    <style name="Theme.VasiliasTyper.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/ink_navy</item>
        <item name="android:navigationBarColor">@color/ink_navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="InkAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/vt_primary</item>
        <item name="colorSurface">@color/ink_surface</item>
        <item name="android:textColorPrimary">@color/ps_text_bright</item>
        <item name="android:textColorSecondary">@color/ps_text</item>
        <item name="shapeAppearanceMediumComponent">@style/InkDialogShape</item>
    </style>

    <style name="InkDialogShape" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="PSButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/ps_text_bright</item>
        <item name="android:background">@drawable/studio_chip_bg</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 44dp touch target with a compact 20dp visual glyph, tuned for one-handed editing.
         Redesign: added ripple feedback so presses feel responsive (interactivity states). -->
    <style name="PSToolButton">
        <item name="android:background">@drawable/tool_btn_bg</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="ToolLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">8sp</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="HiPaintMenuItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/editor_menu_pill</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="HiPaintActionChip" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">34dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">11dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
