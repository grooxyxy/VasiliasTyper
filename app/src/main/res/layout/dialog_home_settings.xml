<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@drawable/system_panel_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Koneksi AI"
            android:textColor="@color/ps_text_bright"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Simpan kredensial lokal untuk OCR, terjemahan, dan inpainting."
            android:textColor="@color/ink_muted"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/dialog_section_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gemini"
                android:textColor="@color/vt_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etGeminiApiKey"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/dialog_field_bg"
                android:hint="Gemini API key"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/ps_text_bright"
                android:textColorHint="@color/ink_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/dialog_section_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Agnes Image 2.1 Flash"
                android:textColor="@color/vt_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAgnesApiKey"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/dialog_field_bg"
                android:hint="Agnes AI API key"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/ps_text_bright"
                android:textColorHint="@color/ink_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etAgnesPrompt"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/dialog_field_bg"
                android:gravity="top|start"
                android:hint="Prompt inpainting"
                android:inputType="textCapSentences|textMultiLine"
                android:textColor="@color/ps_text_bright"
                android:textColorHint="@color/ink_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Kunci tidak pernah disertakan dalam ekspor gambar atau proyek."
            android:textColor="@color/ink_muted"
            android:textSize="10sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
