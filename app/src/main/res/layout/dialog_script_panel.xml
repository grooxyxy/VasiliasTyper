<?xml version="1.0" encoding="utf-8"?>
  <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@drawable/system_panel_bg"
      android:padding="8dp">

      <!-- Title + load buttons -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:paddingBottom="4dp">

          <TextView
              android:layout_width="0dp"
              android:layout_weight="1"
              android:layout_height="wrap_content"
              android:text="Script"
              android:textColor="@color/ps_text_bright"
              android:textSize="13sp"
              android:textStyle="bold"/>

          <!-- Load single script (original binding: btnLoadScript) -->
          <Button
              android:id="@+id/btnLoadScript"
              android:layout_width="wrap_content"
              android:layout_height="30dp"
              android:text="SCRIPT"
              android:textSize="10sp"
              android:backgroundTint="@color/vt_secondary"
              android:layout_marginEnd="4dp"/>

          <!-- v2.0: Load MULTIPLE scripts -->
          <Button
              android:id="@+id/btnLoadMultiScript"
              android:layout_width="wrap_content"
              android:layout_height="30dp"
              android:text="TipeR OCR"
              android:textSize="10sp"
              android:backgroundTint="@color/vt_primary"/>
      </LinearLayout>

      <!-- File name (original binding: tvScriptFileName) -->
      <TextView
          android:id="@+id/tvScriptFileName"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="No script loaded"
          android:textColor="@color/ps_text"
          android:textSize="11sp"
          android:ellipsize="middle"
          android:singleLine="true"
          android:paddingBottom="2dp"/>

      <!-- Progress -->
      <TextView
          android:id="@+id/tvScriptProgress"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text=""
          android:textColor="@color/ps_text"
          android:textSize="11sp"
          android:paddingBottom="4dp"/>


      <!-- TipeR OCR is intentionally started only by explicit user action. -->
      <Button
          android:id="@+id/btnStartScriptOcr"
          android:layout_width="match_parent"
          android:layout_height="36dp"
          android:text="Mulai Script OCR"
          android:textSize="11sp"
          android:enabled="false"
          android:backgroundTint="@color/vt_secondary"
          android:layout_marginBottom="4dp"/>

      <!-- Start line for sequential placement -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:paddingBottom="4dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Start line"
              android:textColor="@color/ps_text"
              android:textSize="11sp"
              android:layout_marginEnd="8dp"/>

          <EditText
              android:id="@+id/editScriptStartLine"
              android:layout_width="72dp"
              android:layout_height="30dp"
              android:inputType="number"
              android:hint="1"
              android:text="1"
              android:textColor="@color/ps_text_bright"
              android:textColorHint="@color/ps_text"
              android:backgroundTint="@color/ink_muted"
              android:paddingStart="8dp"
              android:paddingEnd="8dp"
              android:textSize="11sp"/>
      </LinearLayout>

      <!-- v2.0: Multi-select bar (hidden by default) -->
      <LinearLayout
          android:id="@+id/multiSelectBar"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:visibility="gone"
          android:paddingBottom="4dp">

          <TextView
              android:id="@+id/tvSelectedCount"
              android:layout_width="0dp"
              android:layout_weight="1"
              android:layout_height="wrap_content"
              android:text="0 dipilih"
              android:textColor="@color/ps_text"
              android:textSize="12sp"/>

          <Button
              android:id="@+id/btnUseSelected"
              android:layout_width="wrap_content"
              android:layout_height="28dp"
              android:text="Gunakan"
              android:textSize="10sp"
              android:backgroundTint="@color/vt_secondary"
              android:layout_marginEnd="4dp"/>

          <Button
              android:id="@+id/btnCancelMulti"
              android:layout_width="wrap_content"
              android:layout_height="28dp"
              android:text="Batal"
              android:textSize="10sp"
              android:backgroundTint="@color/ps_border"/>
      </LinearLayout>

      <!-- Script list (original binding: scriptLinesList) -->
      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/scriptLinesList"
          android:layout_width="match_parent"
          android:layout_height="360dp"/>

      <!-- Bottom buttons -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:paddingTop="6dp">

          <!-- Reset used (original binding: btnResetUsed) -->
          <Button
              android:id="@+id/btnResetUsed"
              android:layout_width="0dp"
              android:layout_weight="1"
              android:layout_height="34dp"
              android:text="Reset Used"
              android:textSize="11sp"
              android:backgroundTint="@color/ps_border"
              android:layout_marginEnd="4dp"/>

          <!-- v2.0: Select all -->
          <Button
              android:id="@+id/btnSelectAllScript"
              android:layout_width="0dp"
              android:layout_weight="1"
              android:layout_height="34dp"
              android:text="Pilih Semua"
              android:textSize="11sp"
              android:backgroundTint="@color/vt_secondary"
              android:layout_marginEnd="4dp"/>

          <!-- Type-R: batch text input, one line per bubble -->
          <Button
              android:id="@+id/btnTypeR"
              android:layout_width="0dp"
              android:layout_weight="1"
              android:layout_height="34dp"
              android:text="VasType"
              android:textSize="11sp"
              android:backgroundTint="@color/vt_primary"
              android:layout_marginEnd="4dp"/>

          <!-- v8.0: Place All — batch-place all texts for multi-selected bubbles -->
          <Button
              android:id="@+id/btnPlaceAll"
              android:layout_width="0dp"
              android:layout_weight="1"
              android:layout_height="34dp"
              android:text="Auto Typeset"
              android:textSize="11sp"
              android:backgroundTint="@color/vt_primary"/>
      </LinearLayout>
  </LinearLayout>
  