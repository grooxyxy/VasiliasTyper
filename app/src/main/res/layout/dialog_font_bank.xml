<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/system_panel_bg"
    android:padding="8dp">

    <!-- Search -->
    <EditText
        android:id="@+id/etFontSearch"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:hint="Search font..."
        android:textColor="@color/ps_text_bright"
        android:textColorHint="@color/ps_border"
        android:background="@drawable/edit_text_bg"
        android:padding="8dp"
        android:inputType="text"/>

    <!-- Folder navigation mirrors the grouped CarbonScans font catalog. -->
    <Spinner
        android:id="@+id/spinnerFontFolder"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:contentDescription="Font folder"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnFontMatch"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Local Font Match"
            android:textAllCaps="false"
            android:textColor="@color/ps_text_bright"
            android:textSize="11sp"
            android:backgroundTint="@color/ps_accent"/>

        <Button
            android:id="@+id/btnFontDrive"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Buka Font Drive"
            android:textAllCaps="false"
            android:textColor="@color/ps_text_bright"
            android:textSize="11sp"
            android:backgroundTint="@color/vt_secondary"/>
    </LinearLayout>

    <!-- Import user font button -->
    <Button
        android:id="@+id/btnImportFont"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:text="Import / Download Font (TTF / OTF)"
        android:textAllCaps="false"
        android:textColor="@color/ps_text_bright"
        android:textSize="12sp"
        android:backgroundTint="@color/ps_toolbar"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fontList"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="8dp"/>
</LinearLayout>
