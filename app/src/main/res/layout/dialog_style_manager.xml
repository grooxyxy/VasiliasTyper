<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/system_panel_bg"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Header card ─────────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/vt_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ps_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStyleManagerTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="-0.01"
                        android:text="@string/style_manager_title"
                        android:textColor="@color/ps_text_bright"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStyleCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/studio_chip_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:textColor="@color/ps_text_bright"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="12 style" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStyleManagerSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Style buatan Anda disimpan terpisah dari preset agar panel selalu ringan."
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRestoreWebtoonSfx"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="Buka Preset SFX Webtoon"
                    android:textAllCaps="false"
                    android:textColor="@color/ink_navy"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/ps_accent"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Save-style card ─────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/styleSaveCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/vt_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ps_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="SIMPAN STYLE SAAT INI"
                    android:textColor="@color/ps_accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etStyleName"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/edit_text_bg"
                        android:hint="Nama style…"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textColor="@color/ps_text_bright"
                        android:textColorHint="@color/ink_muted"
                        android:textSize="13sp" />

                    <Spinner
                        android:id="@+id/spinnerStyleFolder"
                        android:layout_width="104dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/ps_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:text="Simpan"
                        android:textAllCaps="false"
                        android:textColor="@color/ink_navy"
                        android:textStyle="bold"
                        app:backgroundTint="@color/ps_accent"
                        app:cornerRadius="14dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <AutoCompleteTextView
                        android:id="@+id/etNewFolder"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/edit_text_bg"
                        android:completionThreshold="1"
                        android:hint="Folder baru…"
                        android:importantForAutofill="no"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textColor="@color/ps_text_bright"
                        android:textColorHint="@color/ink_muted"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddFolder"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:text="+ Folder"
                        android:textAllCaps="false"
                        android:textColor="@color/ps_text"
                        app:backgroundTint="@color/ps_toolbar"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── List card ───────────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/vt_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ps_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Search bar -->
                <EditText
                    android:id="@+id/etStyleSearch"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/edit_text_bg"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    android:drawablePadding="8dp"
                    android:hint="@string/style_search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="@color/ps_text_bright"
                    android:textColorHint="@color/ink_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Folder"
                        android:textColor="@color/ps_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerFilterFolder"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/ps_border" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExpandStyleFolders"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="Buka semua"
                        android:textAllCaps="false"
                        android:textColor="@color/ps_text"
                        android:textSize="10sp"
                        app:backgroundTint="@color/ps_toolbar"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCollapseStyleFolders"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:text="Tutup semua"
                        android:textAllCaps="false"
                        android:textColor="@color/ps_text"
                        android:textSize="10sp"
                        app:backgroundTint="@color/ps_toolbar"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- Empty state -->
                <TextView
                    android:id="@+id/tvStyleEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:paddingVertical="36dp"
                    android:text="@string/style_empty_state"
                    android:textColor="@color/ink_muted"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/stylesList"
                    android:layout_width="match_parent"
                    android:layout_height="360dp"
                    android:layout_marginTop="6dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingVertical="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
