<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/system_panel_bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MULTI-STYLE STUDIO"
            android:textColor="@color/ps_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Gaya berbeda untuk setiap bagian teks"
            android:textColor="@color/ps_text_bright"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pilih karakter, baris, kalimat, atau kata. Setiap bagian dapat memiliki ukuran, font, warna, dan efek sendiri."
            android:textColor="@color/ink_muted"
            android:textSize="11sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/vt_surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ps_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="KONTEN &amp; SELEKSI"
                    android:textColor="@color/ps_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etSpanText"
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edit_text_bg"
                    android:gravity="top|start"
                    android:hint="Tulis atau edit teks di sini…"
                    android:inputType="textCapSentences|textMultiLine"
                    android:padding="12dp"
                    android:textColor="@color/ps_text_bright"
                    android:textColorHint="@color/ps_border"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvSelectionRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/dialog_section_bg"
                    android:padding="9dp"
                    android:text="Pilih beberapa karakter, lalu ketuk Tambah bagian."
                    android:textColor="@color/ps_text"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="PISAHKAN OTOMATIS"
            android:textColor="@color/ps_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpanPerLine"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Per baris"
                android:textAllCaps="false"
                android:textColor="@color/ps_text_bright"
                android:textSize="10sp"
                app:backgroundTint="@color/ps_toolbar"
                app:cornerRadius="13dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpanPerSentence"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Per kalimat"
                android:textAllCaps="false"
                android:textColor="@color/ps_text_bright"
                android:textSize="10sp"
                app:backgroundTint="@color/ps_toolbar"
                app:cornerRadius="13dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpanPerWord"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Per kata"
                android:textAllCaps="false"
                android:textColor="@color/ps_text_bright"
                android:textSize="10sp"
                app:backgroundTint="@color/vt_primary_dark"
                app:cornerRadius="13dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BAGIAN TEKS"
                android:textColor="@color/ps_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ketuk item untuk mengatur gaya"
                android:textColor="@color/ink_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSpans"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/dialog_section_bg"
            android:clipToPadding="false"
            android:padding="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpanAdd"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Tambah bagian"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/ps_accent"
                app:cornerRadius="13dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpanClear"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Hapus semua"
                android:textAllCaps="false"
                android:textColor="@color/ps_text"
                app:backgroundTint="@color/ps_toolbar"
                app:cornerRadius="13dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpanCancel"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Batal"
                android:textAllCaps="false"
                android:textColor="@color/ps_text"
                app:backgroundTint="@color/ps_toolbar"
                app:cornerRadius="13dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpanOk"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:text="Terapkan gaya"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:backgroundTint="@color/ps_accent"
                app:cornerRadius="13dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
